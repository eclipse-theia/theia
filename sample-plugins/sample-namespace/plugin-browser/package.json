{
  "private": true,
  "name": "plugin-browser",
  "version": "1.77.0",
  "browser": "./extension.cjs",
  "license": "EPL-2.0 OR GPL-2.0-only WITH Classpath-exception-2.0",
  "publisher": "sample-namespace",
  "repository": {
    "type": "git",
    "url": "https://github.com/eclipse-theia/theia.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "activationEvents": [
    "onCommand:plugin-browser.hello",
    "onCommand:plugin-browser.secret"
  ],
  "devDependencies": {
    "@types/vscode": "^1.125.0"
  },
  "scripts": {
    "build": "npx @vscode/vsce@3 package --no-dependencies"
  },
  "contributes": {
    "commands": [
      {
        "command": "plugin-browser.hello",
        "title": "Hello from plugin-browser"
      },
      {
        "command": "plugin-browser.secret",
        "title": "Store a Secret from plugin-browser"
      }
    ]
  }
}
