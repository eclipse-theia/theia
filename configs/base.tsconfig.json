{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    // TS 6 defaults `strict` to true; Theia keeps its explicit subset of strictness flags for now.
    "strict": false,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noEmitOnError": false,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "strictNullChecks": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "importHelpers": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": false,
    // TS 6 defaults `types` to []; Node and Mocha globals are needed in all packages (specs live next to sources).
    "types": [
      "node",
      "mocha"
    ],
    // TS 6 defaults this to true; Theia imports CSS for side effects without module declarations.
    "noUncheckedSideEffectImports": false,
    "module": "CommonJS",
    // `moduleResolution: "bundler"` is only valid with `module` set to `preserve`/`es2015`+ (TS5095).
    // Theia emits real CommonJS for the Node backend, so pair CommonJS with `node10` resolution.
    // TS 6 flags `node10` as deprecated (TS5107) and treats it as a build error; silence it until the
    // resolution strategy is migrated.
    "ignoreDeprecations": "6.0",
    "moduleResolution": "node10",
    "target": "ES2023",
    "jsx": "react-jsx",
    "jsxImportSource": "@theia/core/shared/react",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable"
    ],
    "sourceMap": true
  }
}
